---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import PostList from '../components/PostList.astro'
import { newestFirst } from '../journal.mjs'
import { TAGLINE } from '../site.mjs'

const posts = newestFirst(await getCollection('posts'))
---

<Base>
  <p class="lead">{TAGLINE} Every page here is plain HTML: Astro builds it once, and the browser runs no JavaScript.</p>
  <h2 class="section">Latest trips</h2>
  <PostList posts={posts} />
</Base>
